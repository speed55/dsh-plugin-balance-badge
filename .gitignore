# dependencies installed by the package manager
node_modules/
.pnpm-store/

# build outputs
dist/
*.tgz

# audio pipeline intermediates: the generated WAVs and their base64 payloads are
# already embedded in client.js. Rebuild them with assets-src/process_samples.py
# from your own licensed source clips (see assets-src/source/README.md).
assets-src/*.wav
assets-src/*.b64
assets-src/source/*.mp4
assets-src/source/*.mp3
assets-src/source/*.ogg
assets-src/source/*.m4a

# editor / OS noise
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log

# one-off helper used when the git transport to github.com is unreachable
assets-src/push_via_api.mjs
